{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eino:run:2",
  "title": "Eino normalized run record v2",
  "description": "Contract candidate. Structural validation MUST be followed by the semantic checks documented in README.md.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Definition"
      }
    },
    "invocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Invocation"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Content"
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Usage"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Annotation"
      }
    },
    "sourceRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRecord"
      }
    }
  },
  "required": [
    "schemaVersion",
    "run",
    "definitions",
    "invocations",
    "events",
    "relations",
    "contents",
    "usage",
    "annotations"
  ],
  "additionalProperties": false,
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Number": {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "Ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "run",
                "definition",
                "invocation",
                "event",
                "content",
                "usage",
                "annotation"
              ]
            },
            "id": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted",
        "unknown"
      ]
    },
    "Timing": {
      "type": "object",
      "properties": {
        "startedAtMs": {
          "$ref": "#/$defs/UInt"
        },
        "endedAtMs": {
          "$ref": "#/$defs/UInt"
        },
        "durationMs": {
          "$ref": "#/$defs/UInt"
        },
        "basis": {
          "type": "string",
          "enum": [
            "source",
            "observed",
            "monotonic",
            "unknown"
          ]
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "contentRef": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "CaptureIssue": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Id"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "Capture": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "definitions",
              "invocations",
              "events",
              "io",
              "model",
              "state",
              "business"
            ]
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureIssue"
          }
        }
      },
      "required": [
        "state",
        "coverage",
        "issues"
      ],
      "additionalProperties": false
    },
    "Producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "execution",
            "definition"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Id"
        },
        "source": {
          "type": "string",
          "enum": [
            "application",
            "agent",
            "graph",
            "workflow"
          ]
        },
        "rootInvocationId": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "sealedAtMs": {
          "$ref": "#/$defs/UInt"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "capture": {
          "$ref": "#/$defs/Capture"
        },
        "correlation": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "mode",
        "scope",
        "source",
        "status",
        "timing",
        "sealedAtMs",
        "producer",
        "capture"
      ],
      "additionalProperties": false
    },
    "FieldMapping": {
      "type": "object",
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "targetPath": {
          "type": "string"
        }
      },
      "required": [
        "sourcePath",
        "targetPath"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "from": {
          "$ref": "#/$defs/Id"
        },
        "to": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "control",
            "dependency",
            "data",
            "candidate"
          ]
        },
        "branchKey": {
          "type": "string"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldMapping"
          }
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false
    },
    "Definition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "workflow",
            "graph",
            "agent",
            "node",
            "model",
            "tool",
            "operation",
            "boundary"
          ]
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "$ref": "#/$defs/Id"
        },
        "key": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component": {
          "type": "string"
        },
        "semanticKind": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "Parent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "root"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "known"
            },
            "invocationId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "state",
            "invocationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Invocation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "application",
            "workflow",
            "graph",
            "agent",
            "node",
            "model",
            "tool",
            "operation"
          ]
        },
        "name": {
          "type": "string"
        },
        "definitionId": {
          "$ref": "#/$defs/Id"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "inputRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "outputRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          }
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "externalCallId": {
          "type": "string"
        },
        "iteration": {
          "$ref": "#/$defs/UInt"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "parent",
        "status",
        "timing",
        "inputRefs",
        "outputRefs",
        "metrics"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "$ref": "#/$defs/UInt"
        },
        "type": {
          "$ref": "#/$defs/Id"
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        },
        "atMs": {
          "$ref": "#/$defs/UInt"
        },
        "contentRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "targetDefinitionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "attributes": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "id",
        "sequence",
        "type",
        "owner",
        "contentRefs"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "type": "string",
          "enum": [
            "caused_by",
            "responds_to",
            "transfers_to",
            "repairs",
            "derived_from",
            "reads",
            "writes",
            "follows"
          ]
        },
        "from": {
          "$ref": "#/$defs/Ref"
        },
        "to": {
          "$ref": "#/$defs/Ref"
        },
        "evidenceEventId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "id",
        "type",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "ContentData": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "inline"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "required": [
            "availability",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "reference"
            },
            "key": {
              "$ref": "#/$defs/Id"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "$ref": "#/$defs/UInt"
            }
          },
          "required": [
            "availability",
            "key",
            "sha256",
            "byteLength"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "missing"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "availability",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Transform": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "redacted",
            "truncated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "originalByteLength": {
          "$ref": "#/$defs/UInt"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    "Content": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        },
        "role": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "message",
            "model-request",
            "model-response",
            "state",
            "diagnostic",
            "result",
            "evaluation-context",
            "checkpoint",
            "other"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed",
            "projected",
            "reconstructed",
            "imported"
          ]
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transform"
          }
        },
        "data": {
          "$ref": "#/$defs/ContentData"
        }
      },
      "required": [
        "id",
        "owner",
        "role",
        "mediaType",
        "provenance",
        "completeness",
        "transforms",
        "data"
      ],
      "additionalProperties": false
    },
    "TokenCounts": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/UInt"
        },
        "output": {
          "$ref": "#/$defs/UInt"
        },
        "total": {
          "$ref": "#/$defs/UInt"
        },
        "inputCached": {
          "$ref": "#/$defs/UInt"
        },
        "outputReasoning": {
          "$ref": "#/$defs/UInt"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "invocationId": {
          "$ref": "#/$defs/Id"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "provider",
            "measured",
            "estimated",
            "unknown"
          ]
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "tokens": {
          "$ref": "#/$defs/TokenCounts"
        }
      },
      "required": [
        "id",
        "invocationId",
        "source",
        "completeness",
        "tokens"
      ],
      "additionalProperties": false
    },
    "Annotation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
        },
        "schemaVersion": {
          "$ref": "#/$defs/PositiveInt"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "id",
        "owner",
        "type",
        "schemaVersion",
        "payload"
      ],
      "additionalProperties": false
    },
    "SourceRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "owner": {
          "$ref": "#/$defs/Ref"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "id",
        "owner",
        "format",
        "payload"
      ],
      "additionalProperties": false
    },
    "MessagePart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "content"
            },
            "contentRef": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "contentRef"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessagePart"
          }
        },
        "toolRequestEventIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "respondsToEventId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "parts"
      ],
      "additionalProperties": false
    },
    "ToolRequest": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "externalCallId": {
          "type": "string"
        }
      },
      "required": [
        "toolName"
      ],
      "additionalProperties": false
    },
    "TransferRequest": {
      "type": "object",
      "properties": {
        "destinationAgent": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "destinationAgent"
      ],
      "additionalProperties": false
    }
  }
}
